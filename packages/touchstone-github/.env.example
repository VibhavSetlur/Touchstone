APP_ID=123456
PRIVATE_KEY_PATH=./private-key.pem
WEBHOOK_SECRET=replace-me

# Path to the `touchstone` CLI. If unset, expects it on PATH.
TOUCHSTONE_CLI=touchstone

# Optional: where to run the CLI (e.g. ssh to a runner inside the VPC).
# Default: spawn locally.
TOUCHSTONE_RUNNER=local

# Optional: post check-runs to this name (defaults to "touchstone").
CHECK_RUN_NAME=touchstone
